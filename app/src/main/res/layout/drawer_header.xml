<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_eq"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:backgroundTint="#800080"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/white"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Square" />

    <!-- Selection-mode buttons: hidden until a long-press starts selecting
         presets/folders, replacing the plus button in that mode. -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_delete_selected"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        android:backgroundTint="#800080"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@android:drawable/ic_menu_delete"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/white"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Square" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_move_selected"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        android:backgroundTint="#800080"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@android:drawable/ic_menu_agenda"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/white"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Square" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_exit_selection"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        android:backgroundTint="#800080"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@android:drawable/ic_menu_close_clear_cancel"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/white"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Square" />

    <EditText
        android:id="@+id/drawer_search_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:hint="Search presets..."
        android:textColor="@android:color/white"
        android:textColorHint="#CCCCCC"
        android:backgroundTint="@android:color/white"
        android:textSize="14sp"
        android:maxLines="1"
        android:inputType="text" />


</LinearLayout>