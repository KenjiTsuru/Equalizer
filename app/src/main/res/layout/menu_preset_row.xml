<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <!-- Spotify-linked folders only (see bindFolderRefreshAction) - pinned
         first/left, away from the row's own tap target and the folder
         chevron on the right, so it doesn't sit under a right-handed
         thumb's natural tap spot. Its own click target, independent of the
         row's own click/long-click, sized up to a real touch target via
         padding even though the glyph itself is small. -->
    <ImageView
        android:id="@+id/row_refresh_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Sync with Spotify"
        android:src="@drawable/ic_refresh"
        app:tint="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- Title is flexible and the icon (album art for a song preset, the
         expand/collapse chevron for a folder) is pinned last, at a fixed
         size - so the icon always sits in the same spot against the drawer's
         right edge no matter how long the title is, instead of shifting
         around with it. -->
    <TextView
        android:id="@+id/row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="12dp"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="sans-serif" />

    <CheckBox
        android:id="@+id/row_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>