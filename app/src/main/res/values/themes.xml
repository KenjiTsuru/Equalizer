<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AutoEQ" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <!-- Applies app-wide by default - individual TextViews/buttons don't
             need to opt in. sans-serif-light is a built-in Android generic
             family (maps to Roboto Light) - no downloadable font fetch
             needed, unlike the Space Grotesk font this replaced. -->
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="fontFamily">sans-serif-light</item>
    </style>

    <style name="Theme.AutoEQ" parent="Base.Theme.AutoEQ" />

    <style name="ShapeAppearance.App.Square" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <!-- Dark/purple styling for the create-preset, create-folder, and
         playlist-import dialogs, so they match the rest of the app instead
         of the default light MaterialAlertDialog. colorPrimary drives both
         the positive/negative button text and the checked-checkbox tint in
         setMultiChoiceItems; colorControlNormal/textColorHint keep unchecked
         checkboxes and EditText hints visible against the dark surface. -->
    <style name="ThemeOverlay.AutoEQ.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/eq_accent</item>
        <item name="colorAccent">@color/eq_accent</item>
        <item name="colorSecondary">@color/eq_accent</item>
        <item name="colorControlActivated">@color/eq_accent</item>
        <item name="colorControlNormal">@color/eq_text_secondary</item>
        <item name="colorSurface">@color/eq_dialog_background</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/eq_text_secondary</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/eq_text_secondary</item>
        <item name="android:textColorHint">@color/eq_text_secondary</item>
        <item name="textColorAlertDialogListItem">@color/white</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="fontFamily">sans-serif-light</item>
    </style>
</resources>